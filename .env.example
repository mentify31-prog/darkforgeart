# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=127.0.0.1,localhost
DEBUG=True

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_NAME=DarkForgeArt
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TABLE_PREFIX=dfa_
# Set DB_SSL=true in production
DB_SSL=false
DB_CONN_MAX_AGE=60

# ── Platform ──────────────────────────────────────────────────────────────────
PLATFORM_NAME=DarkForge Art
BASE_URL=http://127.0.0.1:8000

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=http://127.0.0.1:8000/payments/verify/
PAYSTACK_CURRENCY=KES

# ── GitHub Storage ────────────────────────────────────────────────────────────
# Repo for storing artwork images (public or private with signed URLs)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=yourusername/darkforge-art-uploads
GITHUB_BRANCH=main
GITHUB_UPLOAD_DIR=artwork

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
DEFAULT_FROM_EMAIL=noreply@darkforgeart.com
FROM_EMAIL=DarkForge Art <noreply@darkforgeart.com>

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/

# ── Admin Emails ──────────────────────────────────────────────────────────────
# Comma-separated emails automatically granted admin role on login
ADMIN_EMAILS=your@email.com

# ── Printful ──────────────────────────────────────────────────────────────────
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# ── Printify ──────────────────────────────────────────────────────────────────
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# ── Cache (optional Redis in production) ──────────────────────────────────────
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=darkforge-cache
CACHE_TIMEOUT=300
